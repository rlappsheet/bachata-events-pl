# Kopiuj do .env i dostosuj
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./data/bachata_events.db
# token wymagany do recznego wywolania /admin/scrape przez HTTP
ADMIN_TOKEN=change-me
# co ile godzin automatyczny scraper ma sie uruchamiac (0 = wylaczony, uzywaj crona/systemd timera)
SCRAPE_INTERVAL_HOURS=0
